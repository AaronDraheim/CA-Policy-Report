#Requires -Modules Microsoft.Graph.Authentication

Add-Type -AssemblyName System.Windows.Forms
Add-Type -AssemblyName System.Drawing

$InputForm = New-Object System.Windows.Forms.Form
$InputForm.Text = "Microsoft Entra Multi-Tenant Conditional Access Assessment"
$InputForm.Size = New-Object System.Drawing.Size(760,545)
$InputForm.StartPosition = "CenterScreen"
$InputLabel = New-Object System.Windows.Forms.Label
$InputLabel.Text = "Enter one tenant per line: Friendly Name | Tenant ID. Tenants are processed top to bottom, and sign-in prompts will appear in this same order."
$InputLabel.Location = New-Object System.Drawing.Point(12,12)
$InputLabel.AutoSize = $true
$InputForm.Controls.Add($InputLabel)
$TenantText = New-Object System.Windows.Forms.TextBox
$TenantText.Multiline = $true
$TenantText.ScrollBars = "Vertical"
$TenantText.Location = New-Object System.Drawing.Point(12,58)
$TenantText.Size = New-Object System.Drawing.Size(716,360)
$TenantText.Font = New-Object System.Drawing.Font("Consolas",10)
$InputForm.Controls.Add($TenantText)
$RunButton = New-Object System.Windows.Forms.Button
$RunButton.Text = "Run Assessment"
$RunButton.Location = New-Object System.Drawing.Point(510,440)
$RunButton.Size = New-Object System.Drawing.Size(105,32)
$RunButton.DialogResult = [System.Windows.Forms.DialogResult]::OK
$InputForm.AcceptButton = $RunButton
$InputForm.Controls.Add($RunButton)
$CancelButton = New-Object System.Windows.Forms.Button
$CancelButton.Text = "Cancel"
$CancelButton.Location = New-Object System.Drawing.Point(623,440)
$CancelButton.Size = New-Object System.Drawing.Size(105,32)
$CancelButton.DialogResult = [System.Windows.Forms.DialogResult]::Cancel
$InputForm.CancelButton = $CancelButton
$InputForm.Controls.Add($CancelButton)
if ($InputForm.ShowDialog() -ne [System.Windows.Forms.DialogResult]::OK) { return }

$TenantTargets = @()
foreach ($Line in ($TenantText.Lines)) {
    if ([string]::IsNullOrWhiteSpace($Line)) { continue }
    $Parts = $Line -split "\|",2
    if ($Parts.Count -ne 2) { throw "Invalid tenant entry: $Line" }
    $TenantTargets += [pscustomobject]@{ Name=$Parts[0].Trim(); TenantId=$Parts[1].Trim() }
}
if ($TenantTargets.Count -eq 0) { throw "No tenants were entered." }

$FolderBrowser = New-Object System.Windows.Forms.FolderBrowserDialog
$FolderBrowser.Description = "Select output folder"
if ($FolderBrowser.ShowDialog() -ne "OK") { return }
$OutputFolder = $FolderBrowser.SelectedPath
$TimeStamp = Get-Date -Format yyyyMMdd_HHmmss
$ReportFile = Join-Path $OutputFolder "ConditionalAccess_MultiTenant_Assessment_$TimeStamp.html"
$JsonFile = Join-Path $OutputFolder "ConditionalAccess_MultiTenant_Raw_$TimeStamp.json"
$Scopes = @("Policy.Read.All","Directory.Read.All","Application.Read.All","RoleManagement.Read.Directory","Agreement.Read.All")

function ConvertTo-HtmlEncoded($Value) { if ($null -eq $Value) { return "" }; return [System.Net.WebUtility]::HtmlEncode([string]$Value) }
function Get-AllGraphPages($Uri) { $Items=[System.Collections.Generic.List[object]]::new(); do { $Page=Invoke-MgGraphRequest -Method GET -Uri $Uri -OutputType Hashtable; foreach($Item in @($Page["value"])) { if($null-ne$Item){$Items.Add([pscustomobject]$Item)} }; $Uri=$Page["@odata.nextLink"] } while(-not[string]::IsNullOrWhiteSpace([string]$Uri)); return @($Items) }
function Get-NormalizedArray($Value) { return @($Value|Where-Object{$null-ne$_-and[string]$_-ne""}|ForEach-Object{([string]$_).ToLowerInvariant()}|Sort-Object -Unique) }
function Get-PolicyPurposeKey($Policy) { if(-not[string]::IsNullOrWhiteSpace([string]$Policy.TemplateId)){return "template:$($Policy.TemplateId)"}; $Name=([string]$Policy.DisplayName).ToLowerInvariant()-replace"[^a-z0-9]+"," "; return "name:$($Name.Trim())" }
function Get-PolicyConfigSignature($Policy) { $U=$Policy.Conditions.Users;$A=$Policy.Conditions.Applications;$L=$Policy.Conditions.Locations;$P=$Policy.Conditions.Platforms;$Parts=@("users="+((Get-NormalizedArray $U.IncludeUsers)-join","),"groups="+((Get-NormalizedArray $U.IncludeGroups)-join","),"roles="+((Get-NormalizedArray $U.IncludeRoles)-join","),"apps="+((Get-NormalizedArray $A.IncludeApplications)-join","),"actions="+((Get-NormalizedArray $A.IncludeUserActions)-join","),"clientApps="+((Get-NormalizedArray $Policy.Conditions.ClientAppTypes)-join","),"platforms="+((Get-NormalizedArray $P.IncludePlatforms)-join","),"locations="+((Get-NormalizedArray $L.IncludeLocations)-join","),"userRisk="+((Get-NormalizedArray $Policy.Conditions.UserRiskLevels)-join","),"signInRisk="+((Get-NormalizedArray $Policy.Conditions.SignInRiskLevels)-join","),"controls="+((Get-NormalizedArray $Policy.GrantControls.BuiltInControls)-join","),"operator="+([string]$Policy.GrantControls.Operator).ToLowerInvariant(),"authStrength="+([string]$Policy.GrantControls.AuthenticationStrength.DisplayName).ToLowerInvariant(),"session="+($Policy.SessionControls|ConvertTo-Json -Depth 30 -Compress)); return ($Parts-join"|") }

$TenantResults=@()
foreach($Target in $TenantTargets){
    Write-Host "Sign in to $($Target.Name) [$($Target.TenantId)]" -ForegroundColor Cyan
    try {
        Disconnect-MgGraph -ErrorAction SilentlyContinue|Out-Null
        Connect-MgGraph -TenantId $Target.TenantId -Scopes $Scopes -ContextScope Process -NoWelcome
        $Context=Get-MgContext
        if($Context.TenantId-ne$Target.TenantId){throw "Connected tenant does not match requested tenant."}
        $Policies=@(Get-AllGraphPages "https://graph.microsoft.com/v1.0/identity/conditionalAccess/policies")
        $BetaPolicies=@(Get-AllGraphPages "https://graph.microsoft.com/beta/identity/conditionalAccess/policies")
        if($BetaPolicies.Count-gt$Policies.Count){$Policies=$BetaPolicies}
        $Policies=@($Policies|Sort-Object Id -Unique)
        $Normalized=@($Policies|ForEach-Object{[pscustomobject]@{PurposeKey=Get-PolicyPurposeKey $_;Signature=Get-PolicyConfigSignature $_;PolicyId=$_.Id;DisplayName=$_.DisplayName;State=$_.State;TemplateId=$_.TemplateId}})
        $TenantResults+=[pscustomobject]@{Name=$Target.Name;TenantId=$Target.TenantId;Account=$Context.Account;Status="Collected";Error=$null;Policies=$Policies;Normalized=$Normalized}
        Write-Host "Collected $($Policies.Count) policies." -ForegroundColor Green
    } catch {
        $TenantResults+=[pscustomobject]@{Name=$Target.Name;TenantId=$Target.TenantId;Account=$null;Status="Collection failed";Error=$_.Exception.Message;Policies=@();Normalized=@()}
        Write-Warning "Collection failed for $($Target.Name): $($_.Exception.Message)"
    }
}
Disconnect-MgGraph -ErrorAction SilentlyContinue|Out-Null

[pscustomobject]@{Generated=(Get-Date).ToString("o");Tenants=$TenantResults}|ConvertTo-Json -Depth 100|Out-File -FilePath $JsonFile -Encoding utf8
$CollectedTenants=@($TenantResults|Where-Object{$_.Status-eq"Collected"})
$AllPurposeKeys=@($CollectedTenants.Normalized.PurposeKey|Sort-Object -Unique)
$MatrixRows=foreach($Key in $AllPurposeKeys){$Cells=@();$Signatures=@();foreach($Tenant in $TenantResults){if($Tenant.Status-ne"Collected"){$Cells+="<td class='failed'>Collection failed</td>";continue};$Matches=@($Tenant.Normalized|Where-Object{$_.PurposeKey-eq$Key});if($Matches.Count-eq0){$Cells+="<td class='missing'>Missing</td>"}elseif($Matches.Count-gt1){$Cells+="<td class='warning'>Multiple ($($Matches.Count))<br>$(($Matches.State|Sort-Object -Unique)-join', ')</td>";$Signatures+=@($Matches.Signature)}else{$Cells+="<td>$($Matches[0].State)</td>";$Signatures+=$Matches[0].Signature}};$UniqueSignatures=@($Signatures|Sort-Object -Unique);$Result=if(($Cells-join"")-match"Missing|Collection failed"){"Incomplete"}elseif($UniqueSignatures.Count-gt1){"Configuration mismatch"}else{"Consistent"};$Display=$Key-replace"^(template:|name:)","";"<tr><td>$(ConvertTo-HtmlEncoded $Display)</td>$($Cells-join'')<td class='$($Result-replace' ','-')'>$Result</td></tr>"}
$TenantHeaders=($TenantResults|ForEach-Object{"<th>$(ConvertTo-HtmlEncoded $_.Name)</th>"})-join""
$TenantCards=($TenantResults|ForEach-Object{"<div class='card'><strong>$(ConvertTo-HtmlEncoded $_.Name)</strong><span>$(@($_.Policies).Count)</span><small>$(ConvertTo-HtmlEncoded $_.Status)</small></div>"})-join""
$TenantSections=foreach($Tenant in $TenantResults){if($Tenant.Status-ne"Collected"){"<details class='tenant'><summary>$(ConvertTo-HtmlEncoded $Tenant.Name) — Collection failed</summary><p class='error'>$(ConvertTo-HtmlEncoded $Tenant.Error)</p></details>";continue};$PolicySections=foreach($Policy in $Tenant.Policies){$Json=ConvertTo-HtmlEncoded ($Policy|ConvertTo-Json -Depth 100);"<details class='policy'><summary><b>$(ConvertTo-HtmlEncoded $Policy.DisplayName)</b><br><small>State: $(ConvertTo-HtmlEncoded $Policy.State) | ID: $(ConvertTo-HtmlEncoded $Policy.Id)</small></summary><pre>$Json</pre></details>"};"<details class='tenant'><summary>$(ConvertTo-HtmlEncoded $Tenant.Name) — $(@($Tenant.Policies).Count) policies</summary><p>Tenant ID: $(ConvertTo-HtmlEncoded $Tenant.TenantId)<br>Account: $(ConvertTo-HtmlEncoded $Tenant.Account)</p>$($PolicySections-join'')</details>"}
$Html="<!doctype html><html><head><meta charset='utf-8'><title>Multi-Tenant Conditional Access Assessment</title><style>body{font-family:Segoe UI,Arial,sans-serif;margin:24px;background:#f5f7fa;color:#242424}h1,h2{color:#0067b8}.cards{display:flex;gap:12px;flex-wrap:wrap}.card{background:white;border-left:5px solid #0078d4;padding:12px 18px;min-width:180px;box-shadow:0 1px 4px #bbb}.card span{display:block;font-size:28px;font-weight:700}table{border-collapse:collapse;width:100%;background:white;table-layout:fixed}th,td{border:1px solid #ccc;padding:8px;vertical-align:top;word-wrap:break-word}th{background:#eaf3f8}.tenant,.policy{background:white;margin:14px 0;box-shadow:0 1px 4px #bbb}.tenant>summary,.policy>summary{cursor:pointer;padding:12px;background:#eaf3f8;color:#004578}.policy{margin:8px 16px}.policy>summary{background:#f3f8fb}.missing,.failed{background:#fde7e9;color:#a80000;font-weight:700}.warning,.Configuration-mismatch,.Incomplete{background:#fff4ce;font-weight:700}.Consistent{background:#dff6dd;color:#107c10;font-weight:700}.error{color:#a80000}pre{white-space:pre-wrap;word-break:break-word;background:#202020;color:#fff;padding:12px;max-height:500px;overflow:auto}</style></head><body><h1>Microsoft Entra Multi-Tenant Conditional Access Assessment</h1><p>Generated: $(Get-Date) | Requested tenants: $($TenantResults.Count) | Successfully collected: $($CollectedTenants.Count)</p><div class='cards'>$TenantCards</div><h2>Cross-tenant policy consistency matrix</h2><p>Policies are matched by template ID and then normalized display name. Configuration consistency compares assignments, conditions, controls, authentication strength, and session controls.</p><table><tr><th>Policy key</th>$TenantHeaders<th>Result</th></tr>$($MatrixRows-join'')</table><h2>Tenant inventories</h2>$($TenantSections-join'')</body></html>"
$Html|Out-File -FilePath $ReportFile -Encoding utf8
Write-Host "Multi-tenant report complete" -ForegroundColor Green
Write-Host "HTML: $ReportFile" -ForegroundColor Yellow
Write-Host "Raw JSON: $JsonFile" -ForegroundColor Yellow
Start-Process -FilePath $ReportFile
