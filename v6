if ($null -eq $DuplicatePolicyCount) { $DuplicatePolicyCount = 0 };
$StateCards = ($StateSummary | ForEach-Object { "<div class='card'><strong>$(ConvertTo-HtmlEncoded $_.Name)</strong><span>$($_.Count)</span></div>" }) -join '';
$DuplicateRows = if ($DuplicateNameGroups.Count -gt 0) { ($DuplicateNameGroups | ForEach-Object { $Ids = ($_.Group.Id | ForEach-Object { ConvertTo-HtmlEncoded $_ }) -join '<br>'; "<tr><td>$(ConvertTo-HtmlEncoded $_.Name)</td><td>$($_.Count)</td><td>$Ids</td></tr>" }) -join '' } else { "<tr><td colspan='3'>No duplicate display names detected.</td></tr>" };
$DuplicateSection = "<details class='summary-details'><summary>Duplicate policy names ($($DuplicateNameGroups.Count) names / $DuplicatePolicyCount policies)</summary><table><tr><th>Display name</th><th>Count</th><th>Policy IDs</th></tr>$DuplicateRows</table></details>";
function Get-NormalizedValues($Value) { return @($Value | Where-Object { $null -ne $_ -and [string]$_ -ne '' } | ForEach-Object { ([string]$_).ToLowerInvariant() } | Sort-Object -Unique) };
function Get-PolicySignature($Policy) { $U=$Policy.Conditions.Users; $A=$Policy.Conditions.Applications; $L=$Policy.Conditions.Locations; $P=$Policy.Conditions.Platforms; $D=$Policy.Conditions.Devices; $Subjects=@((Get-NormalizedValues $U.IncludeUsers)+(Get-NormalizedValues $U.IncludeGroups)+(Get-NormalizedValues $U.IncludeRoles)); $Resources=@((Get-NormalizedValues $A.IncludeApplications)+(Get-NormalizedValues $A.IncludeUserActions)+(Get-NormalizedValues $A.IncludeAuthenticationContextClassReferences)); $Conditions=@((Get-NormalizedValues $Policy.Conditions.ClientAppTypes)+(Get-NormalizedValues $P.IncludePlatforms)+(Get-NormalizedValues $L.IncludeLocations)+(Get-NormalizedValues $Policy.Conditions.UserRiskLevels)+(Get-NormalizedValues $Policy.Conditions.SignInRiskLevels)+@((Format-GraphFilter $D.DeviceFilter))); $Controls=@((Get-NormalizedValues $Policy.GrantControls.BuiltInControls)+@((Get-GraphProperty $Policy.GrantControls 'AuthenticationStrength') | ConvertTo-Json -Depth 20 -Compress)+@($Policy.SessionControls | ConvertTo-Json -Depth 20 -Compress)); $Exclusions=@((Get-NormalizedValues $U.ExcludeUsers)+(Get-NormalizedValues $U.ExcludeGroups)+(Get-NormalizedValues $U.ExcludeRoles)+(Get-NormalizedValues $A.ExcludeApplications)+(Get-NormalizedValues $P.ExcludePlatforms)+(Get-NormalizedValues $L.ExcludeLocations)); [pscustomobject]@{Policy=$Policy;Subjects=$Subjects;Resources=$Resources;Conditions=$Conditions;Controls=$Controls;Exclusions=$Exclusions;SubjectKey=($Subjects-join '|');ResourceKey=($Resources-join '|');ConditionKey=($Conditions-join '|');ControlKey=($Controls-join '|');ExclusionKey=($Exclusions-join '|')} };
function Test-Overlap($A,$B) { if ($A -contains 'all' -or $B -contains 'all') { return $true }; return @($A | Where-Object { $B -contains $_ }).Count -gt 0 };
$PolicySignatures = @($Policies | ForEach-Object { Get-PolicySignature $_ }); $EffectRows = @(); $SeenEffectPairs = @{}; for ($i = 0; $i -lt $PolicySignatures.Count; $i++) { for ($j = $i + 1; $j -lt $PolicySignatures.Count; $j++) { $X = $PolicySignatures[$i]; $Y = $PolicySignatures[$j]; $PairKey = @($X.Policy.Id,$Y.Policy.Id) | Sort-Object; $PairKey = $PairKey -join '|'; if ($SeenEffectPairs.ContainsKey($PairKey)) { continue }; $SeenEffectPairs[$PairKey] = $true; $SubjectOverlap = Test-Overlap $X.Subjects $Y.Subjects; $ResourceOverlap = Test-Overlap $X.Resources $Y.Resources; $SameConditions = ($X.ConditionKey -eq $Y.ConditionKey); $SameControls = ($X.ControlKey -eq $Y.ControlKey); $SameExclusions = ($X.ExclusionKey -eq $Y.ExclusionKey); $SameScope = ($X.SubjectKey -eq $Y.SubjectKey -and $X.ResourceKey -eq $Y.ResourceKey -and $SameConditions -and $SameExclusions); $BothEnforced = ($X.Policy.State -eq 'enabled' -and $Y.Policy.State -eq 'enabled'); $OneReportOnly = (($X.Policy.State -eq 'enabledForReportingButNotEnforced') -xor ($Y.Policy.State -eq 'enabledForReportingButNotEnforced')); $Classification = $null; $Confidence = 'Medium'; if ($SameScope -and $SameControls) { $Classification = 'Exact effect duplicate'; $Confidence = 'High' } elseif ($SameScope -and -not $SameControls -and $BothEnforced) { $Classification = 'Same target, different control'; $Confidence = 'High' } elseif ($SubjectOverlap -and $ResourceOverlap -and $SameControls -and $SameConditions) { $Classification = 'Potential broad or partial overlap'; $Confidence = 'Medium' } elseif ($OneReportOnly -and $SubjectOverlap -and $ResourceOverlap -and ($SameControls -or $SameConditions)) { $Classification = 'Monitoring overlap'; $Confidence = 'Medium' }; if ($Classification) { $SharedSubjects = @($X.Subjects | Where-Object { $Y.Subjects -contains $_ }); $SharedResources = @($X.Resources | Where-Object { $Y.Resources -contains $_ }); $SharedControls = @($X.Controls | Where-Object { $Y.Controls -contains $_ }); $EffectRows += "<tr><td>$Classification<br><b>Confidence:</b> $Confidence</td><td>$(ConvertTo-HtmlEncoded $X.Policy.DisplayName)<br>$(ConvertTo-HtmlEncoded $X.Policy.Id)<br>State: $(ConvertTo-HtmlEncoded $X.Policy.State)</td><td>$(ConvertTo-HtmlEncoded $Y.Policy.DisplayName)<br>$(ConvertTo-HtmlEncoded $Y.Policy.Id)<br>State: $(ConvertTo-HtmlEncoded $Y.Policy.State)</td><td><b>Subjects:</b> $(ConvertTo-HtmlList $SharedSubjects 'Broad/all scope or no exact identifier match')<br><b>Resources:</b> $(ConvertTo-HtmlList $SharedResources 'Broad/all scope or no exact identifier match')<br><b>Conditions identical:</b> $SameConditions<br><b>Controls:</b> $(ConvertTo-HtmlList $SharedControls 'Different controls')<br><b>Exclusions differ:</b> $(-not $SameExclusions)</td></tr>" } } };
$DuplicateEffectCount=$EffectRows.Count; $EffectTable=if($DuplicateEffectCount -gt 0){$EffectRows-join ''}else{"<tr><td colspan='4'>No potential duplicate effects were identified by static configuration comparison.</td></tr>"};
$DuplicateEffectsSection="<details class='summary-details' open><summary>Potential duplicate effects ($DuplicateEffectCount unique policy pairs)</summary><p class='analysis-note'>This section reports each policy-ID pair once and requires meaningful similarity in scope plus conditions or controls. Broad scope alone is not treated as duplicate behavior. Conditional Access evaluation remains cumulative, and dynamic membership, nested groups, sign-in context, device state, and exclusions can change the effective runtime result.</p><table><tr><th>Classification</th><th>Policy A</th><th>Policy B</th><th>Overlap details</th></tr>$EffectTable</table></details>";
$Html = "<!doctype html><html><head><meta charset='utf-8'><title>Conditional Access Assessment</title><style>body{font-family:Segoe UI,Arial,sans-serif;margin:24px;background:#f5f7fa;color:#242424}h1{color:#0067b8;margin-bottom:4px}.meta{color:#605e5c}.cards{display:flex;gap:12px;flex-wrap:wrap;margin:18px 0}.card{background:white;border-left:5px solid #0078d4;padding:12px 18px;min-width:150px;box-shadow:0 1px 4px #bbb}.card span{display:block;font-size:27px;font-weight:700}.toolbar{margin:14px 0}.toolbar button{background:#0078d4;color:white;border:0;padding:8px 12px;margin-right:8px;cursor:pointer;border-radius:2px}.policy,.summary-details{display:block;background:white;margin:14px 0;box-shadow:0 1px 5px #bbb}.policy>summary,.summary-details>summary{cursor:pointer;padding:14px 18px;background:#eaf3f8;color:#004578;font-weight:700}.policy-name{display:block;font-size:18px}.policy-meta{display:block;font-size:12px;color:#605e5c;margin-top:4px}.policy-body{padding:14px 18px}table{border-collapse:collapse;width:100%;table-layout:fixed}th,td{border:1px solid #ccc;padding:8px;vertical-align:top;text-align:left;word-wrap:break-word}th{width:25%;background:#eaf3f8}pre{white-space:pre-wrap;word-break:break-word;background:#202020;color:white;padding:10px;max-height:500px;overflow:auto}details details{box-shadow:none}details details>summary{cursor:pointer;color:#0067b8}.count-note{font-weight:600}.analysis-note{padding:10px 18px;color:#605e5c}.severity-high{color:#a80000;font-weight:700}</style><script>function setPolicies(openState){document.querySelectorAll('details.policy').forEach(function(x){x.open=openState;});}</script></head><body><h1>Microsoft Entra Conditional Access Assessment Report</h1><p class='meta'>Generated: $(Get-Date) | Policies returned by Microsoft Graph: $($Policies.Count)</p><div class='cards'><div class='card'><strong>Total policies</strong><span>$($Policies.Count)</span></div><div class='card'><strong>Duplicate-name policies</strong><span>$DuplicatePolicyCount</span></div><div class='card'><strong>Potential duplicate effects</strong><span>$DuplicateEffectCount</span></div>$StateCards</div><p class='count-note'>Every policy object is included independently. Duplicate display names are retained and distinguished by policy ID.</p><div class='toolbar'><button onclick='setPolicies(true)'>Expand all policies</button><button onclick='setPolicies(false)'>Collapse all policies</button></div>$DuplicateSection$DuplicateEffectsSection$($Sections -join '')</body></html>";
$Html | Out-File -FilePath $ReportFile -Encoding utf8;
Write-Host "Report complete" -ForegroundColor Green;
Write-Host "HTML: $ReportFile" -ForegroundColor Yellow;
