Connect-MgGraph -Scopes "Policy.Read.All","Directory.Read.All","Application.Read.All","RoleManagement.Read.Directory","Agreement.Read.All"

Add-Type -AssemblyName System.Windows.Forms; $FolderBrowser = New-Object System.Windows.Forms.FolderBrowserDialog; $FolderBrowser.Description = "Select Output Folder"; if ($FolderBrowser.ShowDialog() -ne "OK") { Write-Host "Cancelled"; return }; $OutputFolder = $FolderBrowser.SelectedPath; $TimeStamp = Get-Date -Format yyyyMMdd_HHmmss; $ReportFile = Join-Path $OutputFolder "ConditionalAccessAssessment_$TimeStamp.html"; $JsonFile = Join-Path $OutputFolder "ConditionalAccessPolicies_Raw_$TimeStamp.json"; $Context = Get-MgContext; Write-Host "Graph account: $($Context.Account)" -ForegroundColor Cyan; Write-Host "Graph tenant: $($Context.TenantId)" -ForegroundColor Cyan; function Get-AllGraphPages($Uri) { $Items = [System.Collections.Generic.List[object]]::new(); do { $Page = Invoke-MgGraphRequest -Method GET -Uri $Uri -OutputType Hashtable; foreach ($Item in @($Page["value"])) { if ($null -ne $Item) { $Items.Add([pscustomobject]$Item) } }; $Uri = $Page["@odata.nextLink"] } while (-not [string]::IsNullOrWhiteSpace([string]$Uri)); return @($Items) }; Write-Host "Collecting all Conditional Access policies from v1.0..." -ForegroundColor Cyan; $Policies = @(Get-AllGraphPages "https://graph.microsoft.com/v1.0/identity/conditionalAccess/policies?`$top=999"); Write-Host "v1.0 policy count: $($Policies.Count)" -ForegroundColor Cyan; $BetaPolicies = @(Get-AllGraphPages "https://graph.microsoft.com/beta/identity/conditionalAccess/policies?`$top=999"); Write-Host "beta policy count: $($BetaPolicies.Count)" -ForegroundColor Cyan; if ($BetaPolicies.Count -gt $Policies.Count) { Write-Warning "Beta returned more policies than v1.0. The report will use the beta collection so no discoverable policy is omitted."; $Policies = $BetaPolicies }; $Policies = @($Policies | Sort-Object Id -Unique); Write-Host "Unique policies selected for report: $($Policies.Count)" -ForegroundColor Cyan; $Policies | Select-Object DisplayName,Id,State | Format-Table -AutoSize; $Policies | ConvertTo-Json -Depth 100 | Out-File -FilePath $JsonFile -Encoding utf8;

$UserCache = @{}; $GroupCache = @{}; $SPCache = @{}; $LocationCache = @{}; $RoleCache = @{};
function ConvertTo-HtmlEncoded($v) { if ($null -eq $v) { return "" }; return [System.Net.WebUtility]::HtmlEncode([string]$v) }
function ConvertTo-HtmlList($v, $empty = "Not configured") { $a = @($v | Where-Object { $null -ne $_ -and "$_" -ne "" }); if ($a.Count -eq 0) { return (ConvertTo-HtmlEncoded $empty) }; return (($a | ForEach-Object { if ($_ -is [string] -or $_ -is [ValueType]) { ConvertTo-HtmlEncoded $_ } else { ConvertTo-HtmlEncoded ($_ | ConvertTo-Json -Depth 20 -Compress) } }) -join "<br>") }
function Get-GraphProperty($o, $n) { if ($null -eq $o) { return $null }; $p = $o.PSObject.Properties[$n]; if ($p) { return $p.Value }; if ($o.AdditionalProperties -and $o.AdditionalProperties.ContainsKey($n)) { return $o.AdditionalProperties[$n] } }
function Resolve-User($id) { if ([string]::IsNullOrWhiteSpace($id)) { return "" }; if ($id -eq "All") { return "All users" }; if ($UserCache.ContainsKey($id)) { return $UserCache[$id] }; try { $u = Get-MgUser -UserId $id -Property DisplayName,UserPrincipalName -ErrorAction Stop; $n = "$($u.DisplayName) [$($u.UserPrincipalName)]" } catch { $n = $id }; $UserCache[$id] = $n; return $n }
function Resolve-Group($id) { if ([string]::IsNullOrWhiteSpace($id)) { return "" }; if ($GroupCache.ContainsKey($id)) { return $GroupCache[$id] }; try { $n = (Get-MgGroup -GroupId $id -Property DisplayName -ErrorAction Stop).DisplayName } catch { $n = $id }; $GroupCache[$id] = $n; return $n }
function Resolve-App($id) { if ([string]::IsNullOrWhiteSpace($id)) { return "" }; switch ($id) { "All" { return "All cloud applications" }; "Office365" { return "Office 365" }; "MicrosoftAdminPortals" { return "Microsoft Admin Portals" } }; if ($SPCache.ContainsKey($id)) { return $SPCache[$id] }; try { $s = Get-MgServicePrincipal -ServicePrincipalId $id -Property DisplayName,AppId -ErrorAction Stop; $n = "$($s.DisplayName) [AppId: $($s.AppId)]" } catch { $n = $id }; $SPCache[$id] = $n; return $n }
function Resolve-Location($id) { if ([string]::IsNullOrWhiteSpace($id)) { return "" }; if ($id -eq "All") { return "Any location" }; if ($id -eq "AllTrusted") { return "All trusted locations" }; if ($LocationCache.ContainsKey($id)) { return $LocationCache[$id] }; try { $n = (Get-MgIdentityConditionalAccessNamedLocation -NamedLocationId $id -ErrorAction Stop).DisplayName } catch { $n = $id }; $LocationCache[$id] = $n; return $n }
function Resolve-Role($id) { if ([string]::IsNullOrWhiteSpace($id)) { return "" }; if ($RoleCache.ContainsKey($id)) { return $RoleCache[$id] }; try { $n = (Get-MgRoleManagementDirectoryRoleDefinition -UnifiedRoleDefinitionId $id -ErrorAction Stop).DisplayName } catch { $n = $id }; $RoleCache[$id] = $n; return $n }
function Control($c){switch($c){"mfa"{"Require multifactor authentication"};"block"{"Block access"};"passwordChange"{"Require password change"};"compliantDevice"{"Require compliant device"};"domainJoinedDevice"{"Require Microsoft Entra hybrid joined device"};"approvedApplication"{"Require approved client app"};"compliantApplication"{"Require app protection policy"};default{$c}}}
function Format-GraphFilter($f) { if ($null -eq $f) { return "Not configured" }; $mode = Get-GraphProperty $f "Mode"; $rule = Get-GraphProperty $f "Rule"; if ([string]::IsNullOrWhiteSpace([string]$mode) -and [string]::IsNullOrWhiteSpace([string]$rule)) { return "Not configured" }; return "$mode | $rule" }
function New-HtmlRow($label, $value) { return "<tr><th>$(ConvertTo-HtmlEncoded $label)</th><td>$value</td></tr>" }
$Sections = foreach ($Policy in $Policies) { $U = $Policy.Conditions.Users; $A = $Policy.Conditions.Applications; $Loc = $Policy.Conditions.Locations; $Plat = $Policy.Conditions.Platforms; $Dev = $Policy.Conditions.Devices;
$IU = @($U.IncludeUsers | ForEach-Object { Resolve-User $_ }); $EU = @($U.ExcludeUsers | ForEach-Object { Resolve-User $_ }); $IG = @($U.IncludeGroups | ForEach-Object { Resolve-Group $_ }); $EG = @($U.ExcludeGroups | ForEach-Object { Resolve-Group $_ }); $IR = @($U.IncludeRoles | ForEach-Object { Resolve-Role $_ }); $ER = @($U.ExcludeRoles | ForEach-Object { Resolve-Role $_ }); $IA = @($A.IncludeApplications | ForEach-Object { Resolve-App $_ }); $EA = @($A.ExcludeApplications | ForEach-Object { Resolve-App $_ }); $IL = @($Loc.IncludeLocations | ForEach-Object { Resolve-Location $_ }); $EL = @($Loc.ExcludeLocations | ForEach-Object { Resolve-Location $_ }); $GC = @($Policy.GrantControls.BuiltInControls | ForEach-Object { Control $_ });
$Rows = @();
$Rows +=New-HtmlRow "Policy ID" (ConvertTo-HtmlEncoded $Policy.Id);$Rows+=New-HtmlRow "State" (ConvertTo-HtmlEncoded $Policy.State);$Rows+=New-HtmlRow "Created" (ConvertTo-HtmlEncoded $Policy.CreatedDateTime);$Rows+=New-HtmlRow "Modified" (ConvertTo-HtmlEncoded $Policy.ModifiedDateTime);$Rows+=New-HtmlRow "Template ID" (ConvertTo-HtmlEncoded $Policy.TemplateId);
$Rows+=New-HtmlRow "Include users" (ConvertTo-HtmlList $IU);$Rows+=New-HtmlRow "Exclude users" (ConvertTo-HtmlList $EU);$Rows+=New-HtmlRow "Include groups" (ConvertTo-HtmlList $IG);$Rows+=New-HtmlRow "Exclude groups" (ConvertTo-HtmlList $EG);$Rows+=New-HtmlRow "Include directory roles" (ConvertTo-HtmlList $IR);$Rows+=New-HtmlRow "Exclude directory roles" (ConvertTo-HtmlList $ER);$Rows+=New-HtmlRow "Include guest/external users" (ConvertTo-HtmlList @(Get-GraphProperty $U 'IncludeGuestsOrExternalUsers'));$Rows+=New-HtmlRow "Exclude guest/external users" (ConvertTo-HtmlList @(Get-GraphProperty $U 'ExcludeGuestsOrExternalUsers'));
$Rows+=New-HtmlRow "Include applications" (ConvertTo-HtmlList $IA);$Rows+=New-HtmlRow "Exclude applications" (ConvertTo-HtmlList $EA);$Rows+=New-HtmlRow "User actions" (ConvertTo-HtmlList @(Get-GraphProperty $A 'IncludeUserActions'));$Rows+=New-HtmlRow "Authentication contexts" (ConvertTo-HtmlList @(Get-GraphProperty $A 'IncludeAuthenticationContextClassReferences'));$Rows+=New-HtmlRow "Application filter" (ConvertTo-HtmlEncoded (Format-GraphFilter (Get-GraphProperty $A 'ApplicationFilter')));
$Rows+=New-HtmlRow "Client app types" (ConvertTo-HtmlList $Policy.Conditions.ClientAppTypes);$Rows+=New-HtmlRow "Include platforms" (ConvertTo-HtmlList $Plat.IncludePlatforms);$Rows+=New-HtmlRow "Exclude platforms" (ConvertTo-HtmlList $Plat.ExcludePlatforms);$Rows+=New-HtmlRow "Include locations" (ConvertTo-HtmlList $IL);$Rows+=New-HtmlRow "Exclude locations" (ConvertTo-HtmlList $EL);$Rows+=New-HtmlRow "Device filter" (ConvertTo-HtmlEncoded (Format-GraphFilter (Get-GraphProperty $Dev 'DeviceFilter')));
$Rows+=New-HtmlRow "User risk levels" (ConvertTo-HtmlList $Policy.Conditions.UserRiskLevels);$Rows+=New-HtmlRow "Sign-in risk levels" (ConvertTo-HtmlList $Policy.Conditions.SignInRiskLevels);$Rows+=New-HtmlRow "Service principal risk levels" (ConvertTo-HtmlList @(Get-GraphProperty $Policy.Conditions 'ServicePrincipalRiskLevels'));$Rows+=New-HtmlRow "Insider risk levels" (ConvertTo-HtmlList @(Get-GraphProperty $Policy.Conditions 'InsiderRiskLevels'));
$Rows+=New-HtmlRow "Grant operator" (ConvertTo-HtmlList @($Policy.GrantControls.Operator));$Rows+=New-HtmlRow "Built-in grant controls" (ConvertTo-HtmlList $GC);$Rows+=New-HtmlRow "Authentication strength" (ConvertTo-HtmlList @(Get-GraphProperty $Policy.GrantControls 'AuthenticationStrength'));$Rows+=New-HtmlRow "Terms of use IDs" (ConvertTo-HtmlList $Policy.GrantControls.TermsOfUse);$Rows+=New-HtmlRow "Custom authentication factors" (ConvertTo-HtmlList $Policy.GrantControls.CustomAuthenticationFactors);$Rows+=New-HtmlRow "Session controls" "<pre>$(ConvertTo-HtmlEncoded ($Policy.SessionControls|ConvertTo-Json -Depth 30))</pre>";$Rows+=New-HtmlRow "Raw Microsoft Graph policy JSON" "<details><summary>Expand raw JSON</summary><pre>$(ConvertTo-HtmlEncoded ($Policy|ConvertTo-Json -Depth 100))</pre></details>";
"<details class='policy' open><summary><span class='policy-name'>$(ConvertTo-HtmlEncoded $Policy.DisplayName)</span><span class='policy-meta'>State: $(ConvertTo-HtmlEncoded $Policy.State) | ID: $(ConvertTo-HtmlEncoded $Policy.Id)</span></summary><div class='policy-body'><table>$($Rows -join '')</table></div></details>";
}

$StateSummary = $Policies | Group-Object State | Sort-Object Name;
$DuplicateNameGroups = @($Policies | Group-Object DisplayName | Where-Object { $_.Count -gt 1 });
